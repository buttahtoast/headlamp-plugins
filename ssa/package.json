{
  "name": "ssa-inspector",
  "version": "0.1.0-draft.1",
  "description": "Inspect Kubernetes SSA and field-manager ownership on every resource in Headlamp.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build",
    "package": "headlamp-plugin package",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "tsc": "headlamp-plugin tsc",
    "test": "headlamp-plugin test",
    "dev:cluster": "node scripts/dev-cluster.mjs"
  },
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "server-side-apply",
    "managed-fields"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "0.14.0"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "overrides": {
    "typescript": "5.6.2",
    "ws": "8.21.0",
    "vitest": "^3.2.6"
  },
  "headlamp": {
    "extraDist": {
      "LICENSE": "LICENSE",
      "NOTICE": "NOTICE"
    }
  },
  "files": [
    "src/shared",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    "./viewer": "./src/shared/ManagerDiff.tsx",
    "./model": "./src/shared/model.ts"
  },
  "typesVersions": {
    "*": {
      "viewer": [
        "src/shared/ManagerDiff.tsx"
      ],
      "model": [
        "src/shared/model.ts"
      ]
    }
  }
}
