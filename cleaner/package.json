{
  "name": "cleaner",
  "version": "0.1.0",
  "description": "Manage k8s-cleaner policies and reports in Headlamp.",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "start": "headlamp-plugin start",
    "dev:kind": "node scripts/dev-kind.mjs",
    "dev:cluster": "node scripts/dev-kind.mjs",
    "build": "headlamp-plugin build",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "tsc": "headlamp-plugin tsc",
    "test": "vitest run --config vitest.config.ts",
    "package": "headlamp-plugin package"
  },
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "k8s-cleaner"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "0.14.0"
  },
  "dependencies": {
    "@xyflow/react": "12.11.0"
  }
}
