{
  "name": "@headlamp-k8s/cert-manager",
  "version": "0.1.0-draft.3",
  "description": "Certificate operations, expiry visibility and cert-manager diagnostics for Headlamp.",
  "license": "Apache-2.0",
  "scripts": {
    "start": "headlamp-plugin start",
    "dev:cluster": "node scripts/dev-cluster.mjs",
    "build": "headlamp-plugin build",
    "package": "headlamp-plugin package",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "tsc": "headlamp-plugin tsc",
    "test": "vitest run --config vitest.config.ts"
  },
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "cert-manager",
    "certificates"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "0.14.0"
  },
  "dependencies": {
    "@xyflow/react": "12.11.0",
    "yaml": "^2.5.0"
  },
  "overrides": {
    "typescript": "5.6.2",
    "ws": "8.21.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "headlamp": {
    "extraDist": {
      "LICENSE": "LICENSE",
      "NOTICE": "NOTICE",
      "README.md": "README.md"
    }
  }
}
