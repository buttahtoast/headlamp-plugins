{
  "name": "buttah-kubeconfig",
  "version": "0.1.0",
  "description": "Download a kubeconfig from Headlamp. The server, cluster name, and OIDC client come from buttah-kubeconfig-config/config.json.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build && node scripts/yaml-safe-bundle.mjs dist/main.js",
    "package": "headlamp-plugin package",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "tsc": "headlamp-plugin tsc",
    "test": "vitest run --config vitest.config.ts",
    "demo": "node scripts/demo-gif.mjs"
  },
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "kubeconfig",
    "oidc"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "0.14.0"
  },
  "overrides": {
    "typescript": "5.6.2",
    "ws": "8.21.0",
    "vitest": "^3.2.6"
  },
  "headlamp": {
    "extraDist": {
      "LICENSE": "LICENSE",
      "NOTICE": "NOTICE",
      "README.md": "README.md"
    }
  }
}
