{
  "name": "velero",
  "version": "0.1.0",
  "description": "Inspect Velero backups, manage schedules, compare archived objects and recover resources in Headlamp.",
  "license": "Apache-2.0",
  "headlamp": {
    "extraDist": {
      "LICENSE": "LICENSE",
      "NOTICE": "NOTICE",
      "README.md": "README.md",
      "reader": "reader"
    }
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "start": "headlamp-plugin start",
    "dev:cluster": "node scripts/dev-cluster.mjs",
    "build": "headlamp-plugin build",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "tsc": "headlamp-plugin tsc",
    "test": "vitest run --config vitest.config.ts",
    "package": "headlamp-plugin package"
  },
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "velero",
    "backup",
    "restore"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "0.14.0"
  },
  "dependencies": {
    "cron-parser": "^5.3.1"
  }
}
