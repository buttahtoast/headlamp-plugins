{
  "name": "buttah-shell",
  "version": "0.1.0",
  "description": "In-browser kubectl shell for Headlamp. Identity comes from a configured OIDC client, not from a built-in default.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build && node scripts/yaml-safe-bundle.mjs dist/main.js",
    "package": "headlamp-plugin package",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "tsc": "headlamp-plugin tsc",
    "test": "vitest run --config vitest.config.ts",
    "e2e": "npm run build && node scripts/e2e-oidc.mjs",
    "demo": "node scripts/demo-gif.mjs"
  },
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "oidc",
    "shell"
  ],
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0"
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "0.14.0"
  },
  "overrides": {
    "typescript": "5.6.2",
    "ws": "8.21.0",
    "vitest": "^3.2.6"
  },
  "headlamp": {
    "extraDist": {
      "LICENSE": "LICENSE",
      "NOTICE": "NOTICE",
      "README.md": "README.md"
    }
  }
}
